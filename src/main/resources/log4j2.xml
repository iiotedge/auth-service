<Configuration status="WARN" monitorInterval="30">

    <!-- Define Static Properties -->
    <Properties>
        <Property name="SERVICE_NAME">Login-service</Property>
        <Property name="LOG_DIR">logs</Property>
        <Property name="MAX_FILE_SIZE">10MB</Property>
        <Property name="MAX_BACKUP_FILES">10</Property>
        <Property name="PATTERN">%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level [%X{SERVICE_NAME}] %c{1} - %msg%n</Property>
        <Property name="JSON_PATTERN">
            { "timestamp": "%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}",
            "level": "%level",
            "service": "${SERVICE_NAME}",
            "logger": "%c",
            "message": "%msg",
            "thread": "%t" }%n
        </Property>
        <Property name="LOG_FILE">${LOG_DIR}/Login-service.log</Property>
        <Property name="LOG_JSON_FILE">${LOG_DIR}/Login-service.json</Property>
        <Property name="KAFKA_BROKER">kafka:9092</Property>
        <Property name="KAFKA_TOPIC">log_topic</Property>
    </Properties>

    <Appenders>
        <!-- Console Appender (for debugging and local logs) -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}"/>
        </Console>

        <!-- Rolling File Appender (for local logs with rotation) -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_FILE}"
                     filePattern="${LOG_FILE}.%d{yyyy-MM-dd}.gz">
            <PatternLayout pattern="${PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="${MAX_FILE_SIZE}"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- JSON File Appender -->
        <RollingFile name="JsonFile"
                     fileName="${LOG_JSON_FILE}"
                     filePattern="${LOG_JSON_FILE}.%d{yyyy-MM-dd}.gz">
            <PatternLayout pattern="${JSON_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="${MAX_FILE_SIZE}"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- Kafka Appender to send logs to Kafka -->
        <Kafka name="KafkaAppender">
            <Property name="bootstrap.servers">${KAFKA_BROKER}</Property>
            <Property name="topic">${KAFKA_TOPIC}</Property>
            <JsonLayout compact="true" eventEol="true"/>
        </Kafka>

        <!-- Async Logger for better performance -->
        <Async name="AsyncFile">
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="JsonFile"/>
            <AppenderRef ref="KafkaAppender"/>
        </Async>
    </Appenders>

    <Loggers>
        <Logger name="com.iotmining" level="info" additivity="false">
            <AppenderRef ref="AsyncFile"/>
        </Logger>

        <Logger name="org.springframework" level="warn"/>
        <Logger name="org.hibernate" level="warn"/>
        <Logger name="org.apache.kafka" level="warn"/>

        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncFile"/>
        </Root>
    </Loggers>

</Configuration>



